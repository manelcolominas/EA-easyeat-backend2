classDiagram
    class Admin {
        +ObjectId _id
        +String name
        +String email
        +String password
        +String role
    }

    class Customer {
        +ObjectId _id
        +String name
        +String email
        +String password
        +String refreshTokenHash
        +Boolean isActive
        +Date deletedAt
        +String[] profilePictures
        +ObjectId[] pointsWallet
        +ObjectId[] visitHistory
        +ObjectId[] favoriteRestaurants
        +ObjectId[] badges
        +ObjectId[] reviews
    }

    class Restaurant {
        +ObjectId _id
        +String profile.name
        +String profile.description
        +Number profile.globalRating
        +String[] profile.category
        +Object profile.timetable
        +String[] profile.image
        +Object profile.contact
        +String profile.location.city
        +String profile.location.address
        +String profile.location.googlePlaceId
        +GeoJSON profile.location.coordinates
        +ObjectId[] employees
        +ObjectId[] rewards
        +ObjectId statistics
        +ObjectId[] badges
    }

    class Employee {
        +ObjectId _id
        +ObjectId restaurant_id
        +String profile.name
        +String profile.email
        +String profile.phone
        +String profile.password
        +String profile.role
        +String refreshTokenHash
        +Boolean isActive
    }

    class Badge {
        +ObjectId _id
        +String title
        +String description
        +String type
        +Date deletedAt
    }

    class Review {
        +ObjectId _id
        +ObjectId customer_id
        +ObjectId restaurant_id
        +Date date
        +Number globalRating
        +Number ratings.foodQuality
        +Number ratings.staffService
        +Number ratings.cleanliness
        +Number ratings.environment
        +String[] images
        +String comment
        +Number likes
        +Boolean deleted
    }

    class Visit {
        +ObjectId _id
        +ObjectId customer_id
        +ObjectId restaurant_id
        +ObjectId employee_id
        +Date date
        +Number pointsEarned
        +Number billAmount
        +Date deletedAt
    }

    class PointsWallet {
        +ObjectId _id
        +ObjectId customer_id
        +ObjectId restaurant_id
        +Number points
    }

    class Reward {
        +ObjectId _id
        +ObjectId restaurant_id
        +String name
        +String description
        +Number pointsRequired
        +Boolean active
        +Date expiry
        +Number timesRedeemed
    }

    class RewardRedemption {
        +ObjectId _id
        +ObjectId customer_id
        +ObjectId restaurant_id
        +ObjectId reward_id
        +ObjectId employee_id
        +Number pointsUsed
        +String status
        +Date redeemedAt
        +String notes
    }

    class Statistics {
        +ObjectId _id
        +ObjectId restaurant_id
        +Number totalPointsGiven
        +Number loyalCustomers
        +ObjectId[] mostRequestedRewards
        +Number averagePointsPerVisit
    }

    class Dish {
        +ObjectId _id
        +ObjectId restaurant_id
        +String name
        +String description
        +String section
        +Number price
        +String[] images
        +Boolean active
        +String[] availableAt
        +String[] ingredients
        +String[] allergens
        +String[] dietaryFlags
        +String[] flavorProfile
        +String[] cuisineTags
        +String portionSize
        +Number avgRating
        +Number ratingsCount
    }

    class DishRating {
        +ObjectId _id
        +ObjectId customer_id
        +ObjectId dish_id
        +ObjectId restaurant_id
        +Number rating
        +Date deletedAt
    }

    Customer "1" --> "many" PointsWallet : has
    Customer "1" --> "many" Visit : has
    Customer "1" --> "many" Review : writes
    Customer "many" --> "many" Badge : earns
    Customer "many" --> "many" Restaurant : favorites
    Customer "1" --> "many" DishRating : rates

    Restaurant "1" --> "many" Employee : employs
    Restaurant "1" --> "many" Reward : offers
    Restaurant "1" --> "1" Statistics : has
    Restaurant "many" --> "many" Badge : awarded
    Restaurant "1" --> "many" Dish : serves

    PointsWallet "many" --> "1" Restaurant : belongs to
    Visit "many" --> "1" Restaurant : at
    Visit "many" --> "1" Employee : registered by
    Review "many" --> "1" Restaurant : for
    Reward "many" --> "1" Restaurant : belongs to

    RewardRedemption "many" --> "1" Customer : by
    RewardRedemption "many" --> "1" Restaurant : at
    RewardRedemption "many" --> "1" Reward : redeems
    RewardRedemption "many" --> "1" Employee : approved by

    Statistics "1" --> "many" Reward : tracks

    Dish "many" --> "1" Restaurant : belongs to
    DishRating "many" --> "1" Dish : rates
    DishRating "many" --> "1" Customer : by
    DishRating "many" --> "1" Restaurant : at
